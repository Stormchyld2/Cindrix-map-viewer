{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CindrixOps CMAP Viewer",
  "version": "0.1.0",
  "identifier": "com.cindrixops.cmapviewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CindrixOps CMAP Viewer",
        "width": 1280,
        "height": 800,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ]
  }
}
